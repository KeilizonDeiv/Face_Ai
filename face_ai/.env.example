# Copy this file to .env and fill in real values. .env is git-ignored.

# Required: the single shared password used to sign in to the dashboard.
FACE_AI_PASSWORD=change-me

# Recommended: a long random string used to sign session cookies.
# If unset, a random key is generated each time the app starts, which means
# everyone gets logged out whenever the server restarts.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FACE_AI_SECRET_KEY=

# Optional: network binding. Defaults to 127.0.0.1 (localhost only).
# Only change this if you intentionally want the app reachable on your LAN.
FACE_AI_HOST=127.0.0.1
FACE_AI_PORT=5000

# Optional: Flask debug mode (interactive debugger + auto-reload).
# Leave this off (0) unless you're actively developing — the debugger allows
# arbitrary code execution if the app is ever reachable by anyone else.
FLASK_DEBUG=0

# Optional: set to 1 once this app is served over HTTPS (e.g. behind a
# reverse proxy doing TLS termination). Marks the session cookie Secure, so
# it's never sent over plain HTTP. Leave at 0 for local http://127.0.0.1 use.
FACE_AI_HTTPS=0

# Optional: how many hours a login session stays valid before requiring
# signing in again.
FACE_AI_SESSION_HOURS=12
